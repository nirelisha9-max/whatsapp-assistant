# Green API (WhatsApp)
GREEN_API_URL=https://7107.api.greenapi.com
GREEN_API_INSTANCE=7107548081
GREEN_API_TOKEN=your_token_here

# Webhook security (pick any random string)
WEBHOOK_SECRET=change-me-to-a-random-secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Google OAuth2 (from Google Cloud Console - Desktop app)
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth2callback
GOOGLE_REFRESH_TOKEN=   # obtained by running: npm run setup-google

# Assistant identity
ASSISTANT_NAME=עזרא

# Owner info
OWNER_NAME=ניר
OWNER_PHONE=972XXXXXXXXX   # your number without + (e.g. 972501234567)

# Group chats where any member may trigger the bot (comma-separated chat IDs, e.g. 120363023951034197@g.us)
ALLOWED_GROUP_IDS=

# Extra role instructions appended to the system prompt only inside group chats
GROUP_CONTEXT=

# Server
PORT=3000
TIMEZONE=Asia/Jerusalem
