    "build": "tsc",
    "setup-google": "ts-node scripts/setup-google-oauth.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "chrono-node": "^2.7.6",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^144.0.0",
    "node-schedule": "^2.1.1",
    "uuid": "^10.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-schedule": "^2.1.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
